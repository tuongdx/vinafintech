# === Bí mật & môi trường (KHÔNG đẩy .env lên git!) ===
.env
# URL Postgres đích dùng cho scripts/push_db_to_render.py (không được để trong .env:
# pydantic Settings dùng extra='forbid' → .env có key lạ là backend không khởi động được)
.target_db_url

# === Database ===
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# === Cache dữ liệu tải về (tự tạo lại khi chạy) ===
# Ngoại lệ: symbol_directory.json được commit lên git (app chỉ đọc, không tự tạo;
# cần thiết để biết mã nào tồn tại trên 3 sàn khi deploy lên Render).
.cache/*
!.cache/symbol_directory.json

